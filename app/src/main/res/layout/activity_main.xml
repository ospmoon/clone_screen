<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100">

        <osp.moon.clonescreen.customviews.JaggedEdgeView
            android:id="@+id/server_view_id"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:layout_weight="50"
            app:jaggedEdgeHeight="40dp"
            app:numberOfTeeth="5"
            app:flipShape="false"
            app:viewBackgroundColor="@color/server_color"/>

        <osp.moon.clonescreen.customviews.JaggedEdgeView
            android:id="@+id/client_view_id"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:layout_weight="50"
            app:jaggedEdgeHeight="30dp"
            app:numberOfTeeth="5"
            app:flipShape="true"
            app:viewBackgroundColor="@color/client_color"/>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

</RelativeLayout>
