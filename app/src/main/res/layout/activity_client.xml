<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ClientActivity">

    <!-- 1. SurfaceView занимает весь экран. -->
    <!-- Он находится на заднем плане FrameLayout. -->
    <SurfaceView
        android:id="@+id/client_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Контейнер для элементов управления. -->
    <!-- Он находится поверх SurfaceView. -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:padding="16dp"
        android:background="#80000000"> <!-- Полупрозрачный фон для читаемости -->

        <EditText
            android:id="@+id/ip_address_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите IP Мастера"
            android:inputType="phone"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Подключиться" />
    </LinearLayout>

</FrameLayout>
